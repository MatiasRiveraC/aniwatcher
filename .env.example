# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Never commit your real .env file.

# --- Torrent client: deluge or qbittorrent ---
TORRENT_CLIENT=deluge

# --- Deluge daemon (Preferences -> Daemon -> Allow Remote Connections) ---
DELUGE_HOST=192.168.0.10
DELUGE_PORT=58846
DELUGE_USER=your_deluge_user
DELUGE_PASS=your_deluge_password

# --- qBittorrent Web UI (used when TORRENT_CLIENT=qbittorrent) ---
QBIT_URL=http://192.168.0.10:8080
QBIT_USER=admin
QBIT_PASS=your_qbittorrent_password
# Torrents are added under this category and saved to TORRENT_INCOMING.
QBIT_CATEGORY=aniwatcher
# false = finished torrents keep seeding; their files are hard-linked (or
#         copied) for renaming, so the library gets its own copy.
# true  = finished torrents are removed from qBittorrent and their files moved.
QBIT_STOP_SEEDING=false

# --- MyAnimeList API client ID (https://myanimelist.net/apiconfig) ---
MAL_CLIENT_ID=your_mal_client_id

# --- Paths (used both on the host and inside the container) ---
ANIME_BASE=/media/anime
TORRENT_DONE=/downloads/completed
# qBittorrent only: where it saves AniWatcher's torrents while downloading.
# Must be the same path qBittorrent itself sees.
TORRENT_INCOMING=/downloads/incoming
# true = the folders above can't be changed from the web UI (recommended:
# the UI has no login and can delete files in TORRENT_DONE).
LOCK_PATHS=false

# --- User the container runs as; must own ANIME_BASE and the downloads ---
PUID=568
PGID=568

# --- Timers (seconds) ---
POLL_INTERVAL=900
WATCH_INTERVAL=60

# --- Host port for the web UI ---
WEB_PORT=5000
